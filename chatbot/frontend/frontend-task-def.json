{
  "family": "chatbot-{{ENV}}-frontend-task",
  "executionRoleArn": "arn:aws:iam::855738538544:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "containerDefinitions": [
    {
      "name": "chatbot-{{ENV}}-frontend",
      "image": "<IMAGE_URI>",
      "essential": true,
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/chatbot-{{ENV}}-frontend-task",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}